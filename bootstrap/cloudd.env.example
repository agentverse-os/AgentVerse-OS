# /etc/cloudos/cloudd.env — mode 0600, root. Secrets go here, not into git.
CLOUDD_EDGE_HOST=box.tailnet-name.ts.net
CLOUDD_REPO_DIR=/var/lib/cloudos/repo
CLOUDD_STATE_DIR=/var/lib/cloudos
CLOUDD_CODER_URL=http://127.0.0.1:7080
CLOUDD_CODER_PORT=8444
CLOUDD_AGENTS_PORT=8445           # the Agents app as a separate application (PWA) behind edge
CLOUDD_CODER_TOKEN=            # coder tokens create --lifetime 8760h --name cloudd
CLOUDD_CODER_TEMPLATE=cloudos-incus
CLOUDD_KOMODO_URL=http://127.0.0.1:9120
CLOUDD_KOMODO_KEY=
CLOUDD_KOMODO_SECRET=
CLOUDD_KOMODO_SERVER=Local
CLOUDD_EDGE_CONTAINER=cloudos-edge
# Tailscale: CLOUDD_EDGE_HOST=<box>.<tailnet>.ts.net and CLOUDD_TLS_INTERNAL=false — the Let's Encrypt certificate comes from tailscaled
# (MagicDNS and HTTPS Certificates are enabled in the tailnet admin console, /var/run/tailscale is mounted into edge). Until Tailscale
# is connected the installer writes the host IP and CLOUDD_TLS_INTERNAL=true (the internal CA of edge). Fallback entries by IP —
# CLOUDD_EDGE_ALT_HOSTS.
CLOUDD_TLS_INTERNAL=false
CLOUDD_EDGE_ALT_HOSTS=
# The update channel (stable.json), unless it is set in the Updates window
# CLOUDD_UPDATE_URL=
# The perimeter (ADR-010). The core listens on loopback and on a unix socket in a directory shared with the edge container; the host
# firewall rules (they close the control panel to workspaces and app containers) are installed and checked once a minute by the core itself.
# CLOUDD_EDGE_RUN_DIR=/run/cloudos-edge   # the socket directory; the same path is mounted into edge
# CLOUDD_FIREWALL=off                     # leave the host firewall alone
# CLOUDD_LISTEN=127.0.0.1:7100            # TCP addresses of the API; the Docker bridge need not be added
