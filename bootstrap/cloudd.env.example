# /etc/cloudos/cloudd.env — права 0600, root. Секреты сюда, не в git.
CLOUDD_EDGE_HOST=box.tailnet-name.ts.net
CLOUDD_REPO_DIR=/var/lib/cloudos/repo
CLOUDD_STATE_DIR=/var/lib/cloudos
CLOUDD_CODER_URL=http://127.0.0.1:7080
CLOUDD_CODER_PORT=8444
CLOUDD_CODER_TOKEN=            # coder tokens create --lifetime 8760h --name cloudd
CLOUDD_CODER_TEMPLATE=cloudos-incus
CLOUDD_KOMODO_URL=http://127.0.0.1:9120
CLOUDD_KOMODO_KEY=
CLOUDD_KOMODO_SECRET=
CLOUDD_KOMODO_SERVER=Local
CLOUDD_EDGE_CONTAINER=cloudos-edge
# Tailscale: CLOUDD_EDGE_HOST=<box>.<tailnet>.ts.net и CLOUDD_TLS_INTERNAL=false — сертификат Let's Encrypt берётся у tailscaled
# (в админке tailnet включены MagicDNS и HTTPS Certificates, каталог /var/run/tailscale смонтирован в edge). До подключения
# Tailscale установщик пишет IP хоста и CLOUDD_TLS_INTERNAL=true (внутренний CA edge). Запасные входы по IP — CLOUDD_EDGE_ALT_HOSTS.
CLOUDD_TLS_INTERNAL=false
CLOUDD_EDGE_ALT_HOSTS=
# Канал обновлений (stable.json), если не задан в окне «Обновления»
# CLOUDD_UPDATE_URL=
