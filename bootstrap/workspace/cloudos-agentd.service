# The unit of the AgentVerse OS adapter inside a workspace (ADR-006). cloudd installs and enables it together with the binary and
# the token — like /etc/cloudos/env.sh; the Coder template does not know about it. Runs as coder: terminals and agents have the
# owner's rights. KillMode is the default (control-group): for now a restart of the unit kills its PTYs too — a separate scope for
# them (the Orca lesson) will come together with agent sessions.
[Unit]
Description=AgentVerse OS workspace agent: PTY-демон, сессии агентов, файлы
After=network-online.target
Wants=network-online.target

[Service]
User=coder
Group=coder
Environment=HOME=/home/coder
Environment=USER=coder
Environment=SHELL=/bin/bash
Environment=RUST_LOG=info
EnvironmentFile=-/etc/cloudos/agentd.env
WorkingDirectory=/home/coder
ExecStart=/usr/local/bin/cloudos-agentd --listen 0.0.0.0:7200 --token-file /etc/cloudos/agentd.token
Restart=always
RestartSec=2
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
