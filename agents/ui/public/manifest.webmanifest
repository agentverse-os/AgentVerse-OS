{
  "id": "/agents/",
  "name": "AgentVerse Agents",
  "short_name": "Agents",
  "description": "Агенты AgentVerse OS: беседы, рутины, модели и расходы",
  "start_url": "/agents/",
  "scope": "/agents/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0c10",
  "theme_color": "#0a0c10",
  "lang": "ru",
  "icons": [
    {
      "src": "/agents/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/agents/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/agents/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "productivity",
    "developer tools"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Новая беседа",
      "short_name": "Новая",
      "description": "Беседа с агентом в рабочем месте",
      "url": "/agents/?new=1",
      "icons": [
        {
          "src": "/agents/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Входящие",
      "short_name": "Входящие",
      "description": "Запросы разрешений и завершённые ходы",
      "url": "/agents/?section=inbox",
      "icons": [
        {
          "src": "/agents/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Чат",
      "short_name": "Чат",
      "description": "Простой чат с моделью",
      "url": "/agents/?section=chat",
      "icons": [
        {
          "src": "/agents/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/agents/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "text/plain",
            "text/markdown",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
